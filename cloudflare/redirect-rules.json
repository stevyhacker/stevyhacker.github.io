[
  {
    "description": "Canonical host: bogosavljevic.me to www.bogosavljevic.me",
    "expression": "(http.host eq \"bogosavljevic.me\")",
    "action": "redirect",
    "action_parameters": {
      "from_value": {
        "status_code": 308,
        "target_url": {
          "expression": "concat(\"https://www.bogosavljevic.me\", http.request.uri.path)"
        },
        "preserve_query_string": true
      }
    },
    "enabled": true
  }
]
