{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bogosavljevic",
  "compatibility_date": "2026-09-14",
  "account_id": "cfd3e739cdd3b76c04b5390bb9d5964f",
  "main": "cloudflare/media-ranges.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/*.mp4", "/*.m4a", "/*.mp3", "/*.webm", "/*.mov"]
  },
  "workers_dev": true,
  "routes": [
    {
      "pattern": "www.bogosavljevic.me",
      "custom_domain": true,
      "zone_name": "bogosavljevic.me"
    },
    {
      "pattern": "bogosavljevic.me",
      "custom_domain": true,
      "zone_name": "bogosavljevic.me"
    },
    {
      "pattern": "stevan.bogosavljevic.me",
      "custom_domain": true,
      "zone_name": "bogosavljevic.me"
    }
  ]
}
